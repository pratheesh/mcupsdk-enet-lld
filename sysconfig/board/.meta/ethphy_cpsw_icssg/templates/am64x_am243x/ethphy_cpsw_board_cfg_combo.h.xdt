%%{
    /* Renders ethphy_cpsw_board_cfg.h.xdt, namespaced when CPSW and ICSSG
     * are used together on one core (see /networking/common/enet_combo) */
    let combo = system.getScript("/networking/common/enet_combo");
%%}
`combo.renderBoardTemplate(combo.cpswModuleName, "/board/ethphy_cpsw_icssg/templates/am64x_am243x/ethphy_cpsw_board_cfg.h.xdt")`
