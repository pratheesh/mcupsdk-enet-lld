%%{
    /*
     * CPSW + ICSSG on one core: public Enet SoC / application API.
     *
     * Each peripheral's generated code above is namespaced (_Icssg / _Cpsw
     * suffixes). The functions below are the public names used by the Enet LLD
     * library and by applications; they forward each call to the peripheral
     * that owns the Enet type, handle, instance index or DMA channel index.
     *
     * Global index spaces: ICSSG instances and DMA channels come first,
     * followed by the CPSW ones.
     */
    let combo = system.getScript("/networking/common/enet_combo");
%%}

/* ========================================================================== */
/*          CPSW + ICSSG on one core: dispatch to each peripheral             */
/* ========================================================================== */

#include <enet_apputils.h>
#include <enet_appsoc.h>
#include <enet_apprm.h>
#include <enet_udmautils.h>
#include <include/core/enet_types.h>

#define ENETAPP_COMBO_ICSSG_INST_NUM          (`combo.getIcssgInstanceCount()`U)
#define ENETAPP_COMBO_ICSSG_TX_CH_NUM         (`combo.getIcssgTxChannelCount()`U)
#define ENETAPP_COMBO_ICSSG_RX_CH_NUM         (`combo.getIcssgRxChannelCount()`U)

% for (let side of ["Icssg", "Cpsw"]) {
/* Defined in the `side === "Icssg" ? "ICSSG" : "CPSW"` part of ti_enet_config.c / ti_enet_open_close.c */
void EnetApp_driverInit_`side`(void);
void EnetApp_driverDeInit_`side`(void);
int32_t EnetApp_driverOpen_`side`(Enet_Type enetType, uint32_t instId);
void EnetApp_driverClose_`side`(Enet_Type enetType, uint32_t instId);
void EnetApp_getEnetInstInfo_`side`(uint32_t enetInstanceId, Enet_Type *enetType, uint32_t *instId);
void EnetApp_getEnetInstMacInfo_`side`(Enet_Type enetType, uint32_t instId, Enet_MacPort macPortList[], uint8_t *numMacPorts);
void EnetApp_acquireHandleInfo_`side`(Enet_Type enetType, uint32_t instId, EnetApp_HandleInfo *handleInfo);
void EnetApp_releaseHandleInfo_`side`(Enet_Type enetType, uint32_t instId);
void EnetApp_coreAttach_`side`(Enet_Type enetType, uint32_t instId, uint32_t coreId, EnetPer_AttachCoreOutArgs *attachInfo);
void EnetApp_coreDetach_`side`(Enet_Type enetType, uint32_t instId, uint32_t coreId, uint32_t coreKey);
bool EnetApp_isPortLinked_`side`(Enet_Handle hEnet);
void EnetApp_getTxDmaHandle_`side`(uint32_t enetTxDmaChId, const EnetApp_GetDmaHandleInArgs *inArgs, EnetApp_GetTxDmaHandleOutArgs *outArgs);
void EnetApp_getRxDmaHandle_`side`(uint32_t enetRxDmaChId, const EnetApp_GetDmaHandleInArgs *inArgs, EnetApp_GetRxDmaHandleOutArgs *outArgs);
void EnetApp_closeTxDma_`side`(uint32_t enetTxDmaChId, Enet_Handle hEnet, uint32_t coreKey, uint32_t coreId, EnetDma_PktQ *fqPktInfoQ, EnetDma_PktQ *cqPktInfoQ);
void EnetApp_closeRxDma_`side`(uint32_t enetRxDmaChId, Enet_Handle hEnet, uint32_t coreKey, uint32_t coreId, EnetDma_PktQ *fqPktInfoQ, EnetDma_PktQ *cqPktInfoQ);
void EnetApp_getMacAddress_`side`(uint32_t enetRxDmaChId, EnetApp_GetMacAddrOutArgs *outArgs);
int32_t EnetApp_applyClassifier_`side`(Enet_Handle hEnet, uint32_t coreId, uint8_t *dstMacAddr, uint32_t vlanId, uint32_t ethType, uint32_t rxFlowIdx);
int32_t EnetApp_filterPriorityPacketsCfg_`side`(Enet_Handle hEnet, uint32_t coreId);
int32_t EnetApp_getRxTimeStamp_`side`(Enet_Handle hEnet, uint32_t coreId, EnetTimeSync_GetEthTimestampInArgs *inArgs, uint64_t *ts);
int32_t EnetApp_setTimeStampComplete_`side`(Enet_Handle hEnet, uint32_t coreId);
% }
Udma_DrvHandle EnetApp_getUdmaInstanceHandle_Icssg(void);
void EnetAppUtils_setCommonRxFlowPrms_Icssg(EnetUdma_OpenRxFlowPrms *pRxFlowPrms);
void EnetAppUtils_setCommonTxChPrms_Icssg(EnetUdma_OpenTxChPrms *pTxChPrms);
int32_t EnetAppSoc_fillMacAddrList_Icssg(uint8_t macAddr[][ENET_MAC_ADDR_LEN], uint32_t maxMacEntries, uint32_t *pAvailMacEntries);

static bool EnetAppCombo_isIcssgHandle(Enet_Handle hEnet)
{
    bool isIcssg = false;
    uint32_t i;

    for (i = 0U; i < EnetSoc_getEnetNum_Icssg(); i++)
    {
        if (EnetSoc_getEnetHandleByIdx_Icssg(i) == hEnet)
        {
            isIcssg = true;
            break;
        }
    }

    return isIcssg;
}

/* ---------------------------- Enet SoC (enet_soc.h) ----------------------- */

int32_t EnetSoc_init(void)
{
    int32_t status;

    status = EnetSoc_init_Icssg();
    if (status == ENET_SOK)
    {
        status = EnetSoc_init_Cpsw();
    }

    return status;
}

void EnetSoc_deinit(void)
{
    EnetSoc_deinit_Cpsw();
    EnetSoc_deinit_Icssg();
}

EnetDma_Handle EnetSoc_getDmaHandle(Enet_Type enetType,
                                    uint32_t instId)
{
    return Enet_isCpswFamily(enetType) ? EnetSoc_getDmaHandle_Cpsw(enetType, instId) :
                                         EnetSoc_getDmaHandle_Icssg(enetType, instId);
}

Enet_Handle EnetSoc_getEnetHandleByIdx(uint32_t idx)
{
    uint32_t icssgNum = EnetSoc_getEnetNum_Icssg();

    return (idx < icssgNum) ? EnetSoc_getEnetHandleByIdx_Icssg(idx) :
                              EnetSoc_getEnetHandleByIdx_Cpsw(idx - icssgNum);
}

Enet_Handle EnetSoc_getEnetHandle(Enet_Type enetType,
                                  uint32_t instId)
{
    return Enet_isCpswFamily(enetType) ? EnetSoc_getEnetHandle_Cpsw(enetType, instId) :
                                         EnetSoc_getEnetHandle_Icssg(enetType, instId);
}

uint32_t EnetSoc_getEnetNum(void)
{
    return EnetSoc_getEnetNum_Icssg() + EnetSoc_getEnetNum_Cpsw();
}

uint32_t EnetSoc_getMacPortMax(Enet_Type enetType,
                               uint32_t instId)
{
    return Enet_isCpswFamily(enetType) ? EnetSoc_getMacPortMax_Cpsw(enetType, instId) :
