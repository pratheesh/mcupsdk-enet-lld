/* ------------------- Driver open / close (ti_enet_open_close.h) ----------- */

void EnetApp_driverInit(void)
{
    /* Enet_init() and EnetMem_init() are common to both peripherals */
    EnetApp_driverInit_Icssg();
}

void EnetApp_driverDeInit(void)
{
    EnetApp_driverDeInit_Icssg();
}

int32_t EnetApp_driverOpen(Enet_Type enetType, uint32_t instId)
{
    return Enet_isCpswFamily(enetType) ? EnetApp_driverOpen_Cpsw(enetType, instId) :
                                         EnetApp_driverOpen_Icssg(enetType, instId);
}

% let icssgMcm = combo.isMcmEnabled(combo.icssModuleName);
% let cpswMcm  = combo.isMcmEnabled(combo.cpswModuleName);
% if (!icssgMcm || !cpswMcm) {
void EnetApp_driverClose(Enet_Type enetType, uint32_t instId)
{
    if (Enet_isCpswFamily(enetType))
    {
%   if (cpswMcm) {
        /* CPSW has MCM enabled: its driver is closed by MCM */
        EnetAppUtils_assert(false);
%   } else {
        EnetApp_driverClose_Cpsw(enetType, instId);
%   }
    }
    else
    {
%   if (icssgMcm) {
        /* ICSSG has MCM enabled: its driver is closed by MCM */
        EnetAppUtils_assert(false);
%   } else {
        EnetApp_driverClose_Icssg(enetType, instId);
%   }
    }
}
% }

/* ---------------------- Application utils (enet_apputils.h) -------------- */

void EnetApp_getEnetInstInfo(uint32_t enetInstanceId,
                             Enet_Type *enetType,
                             uint32_t *instId)
{
    if (enetInstanceId < ENETAPP_COMBO_ICSSG_INST_NUM)
    {
        EnetApp_getEnetInstInfo_Icssg(enetInstanceId, enetType, instId);
    }
    else
    {
        EnetApp_getEnetInstInfo_Cpsw(enetInstanceId - ENETAPP_COMBO_ICSSG_INST_NUM, enetType, instId);
    }
}

void EnetApp_getEnetInstMacInfo(Enet_Type enetType,
                                uint32_t instId,
                                Enet_MacPort macPortList[],
                                uint8_t *numMacPorts)
{
    if (Enet_isCpswFamily(enetType))
    {
        EnetApp_getEnetInstMacInfo_Cpsw(enetType, instId, macPortList, numMacPorts);
    }
    else
    {
        EnetApp_getEnetInstMacInfo_Icssg(enetType, instId, macPortList, numMacPorts);
    }
}

void EnetApp_acquireHandleInfo(Enet_Type enetType,
                               uint32_t instId,
                               EnetApp_HandleInfo *handleInfo)
{
    if (Enet_isCpswFamily(enetType))
    {
        EnetApp_acquireHandleInfo_Cpsw(enetType, instId, handleInfo);
    }
    else
    {
        EnetApp_acquireHandleInfo_Icssg(enetType, instId, handleInfo);
    }
}

void EnetApp_releaseHandleInfo(Enet_Type enetType,
                               uint32_t instId)
{
    if (Enet_isCpswFamily(enetType))
    {
        EnetApp_releaseHandleInfo_Cpsw(enetType, instId);
    }
    else
    {
        EnetApp_releaseHandleInfo_Icssg(enetType, instId);
    }
}

void EnetApp_coreAttach(Enet_Type enetType,
                        uint32_t instId,
                        uint32_t coreId,
                        EnetPer_AttachCoreOutArgs *attachInfo)
{
    if (Enet_isCpswFamily(enetType))
    {
        EnetApp_coreAttach_Cpsw(enetType, instId, coreId, attachInfo);
    }
    else
    {
        EnetApp_coreAttach_Icssg(enetType, instId, coreId, attachInfo);
    }
}

void EnetApp_coreDetach(Enet_Type enetType,
                        uint32_t instId,
                        uint32_t coreId,
                        uint32_t coreKey)
{
    if (Enet_isCpswFamily(enetType))
    {
        EnetApp_coreDetach_Cpsw(enetType, instId, coreId, coreKey);
    }
    else
    {
        EnetApp_coreDetach_Icssg(enetType, instId, coreId, coreKey);
    }
}

bool EnetApp_isPortLinked(Enet_Handle hEnet)
{
    return EnetAppCombo_isIcssgHandle(hEnet) ? EnetApp_isPortLinked_Icssg(hEnet) :
                                               EnetApp_isPortLinked_Cpsw(hEnet);
}

void EnetApp_getTxDmaHandle(uint32_t enetTxDmaChId,
                            const EnetApp_GetDmaHandleInArgs *inArgs,
                            EnetApp_GetTxDmaHandleOutArgs *outArgs)
{
    if (enetTxDmaChId < ENETAPP_COMBO_ICSSG_TX_CH_NUM)
    {
        EnetApp_getTxDmaHandle_Icssg(enetTxDmaChId, inArgs, outArgs);
    }
    else
    {
        EnetApp_getTxDmaHandle_Cpsw(enetTxDmaChId - ENETAPP_COMBO_ICSSG_TX_CH_NUM, inArgs, outArgs);
    }
}

void EnetApp_getRxDmaHandle(uint32_t enetRxDmaChId,
                            const EnetApp_GetDmaHandleInArgs *inArgs,
                            EnetApp_GetRxDmaHandleOutArgs *outArgs)
{
    if (enetRxDmaChId < ENETAPP_COMBO_ICSSG_RX_CH_NUM)
    {
        EnetApp_getRxDmaHandle_Icssg(enetRxDmaChId, inArgs, outArgs);
    }
    else
    {
        EnetApp_getRxDmaHandle_Cpsw(enetRxDmaChId - ENETAPP_COMBO_ICSSG_RX_CH_NUM, inArgs, outArgs);
    }
}

void EnetApp_closeTxDma(uint32_t enetTxDmaChId,
                        Enet_Handle hEnet,
                        uint32_t coreKey,
                        uint32_t coreId,
                        EnetDma_PktQ *fqPktInfoQ,
                        EnetDma_PktQ *cqPktInfoQ)
{
    if (enetTxDmaChId < ENETAPP_COMBO_ICSSG_TX_CH_NUM)
    {
        EnetApp_closeTxDma_Icssg(enetTxDmaChId, hEnet, coreKey, coreId, fqPktInfoQ, cqPktInfoQ);
    }
    else
    {
        EnetApp_closeTxDma_Cpsw(enetTxDmaChId - ENETAPP_COMBO_ICSSG_TX_CH_NUM,
                                hEnet, coreKey, coreId, fqPktInfoQ, cqPktInfoQ);
    }
}

void EnetApp_closeRxDma(uint32_t enetRxDmaChId,
                        Enet_Handle hEnet,
                        uint32_t coreKey,
                        uint32_t coreId,
                        EnetDma_PktQ *fqPktInfoQ,
                        EnetDma_PktQ *cqPktInfoQ)
{
    if (enetRxDmaChId < ENETAPP_COMBO_ICSSG_RX_CH_NUM)
    {
        EnetApp_closeRxDma_Icssg(enetRxDmaChId, hEnet, coreKey, coreId, fqPktInfoQ, cqPktInfoQ);
    }
    else
    {
        EnetApp_closeRxDma_Cpsw(enetRxDmaChId - ENETAPP_COMBO_ICSSG_RX_CH_NUM,
                                hEnet, coreKey, coreId, fqPktInfoQ, cqPktInfoQ);
    }
}

void EnetApp_getMacAddress(uint32_t enetRxDmaChId,
                           EnetApp_GetMacAddrOutArgs *outArgs)
{
    if (enetRxDmaChId < ENETAPP_COMBO_ICSSG_RX_CH_NUM)
    {
        EnetApp_getMacAddress_Icssg(enetRxDmaChId, outArgs);
    }
    else
    {
        EnetApp_getMacAddress_Cpsw(enetRxDmaChId - ENETAPP_COMBO_ICSSG_RX_CH_NUM, outArgs);
    }
}

int32_t EnetApp_applyClassifier(Enet_Handle hEnet,
                                uint32_t coreId,
                                uint8_t *dstMacAddr,
                                uint32_t vlanId,
                                uint32_t ethType,
                                uint32_t rxFlowIdx)
{
    return EnetAppCombo_isIcssgHandle(hEnet) ?
           EnetApp_applyClassifier_Icssg(hEnet, coreId, dstMacAddr, vlanId, ethType, rxFlowIdx) :
           EnetApp_applyClassifier_Cpsw(hEnet, coreId, dstMacAddr, vlanId, ethType, rxFlowIdx);
}

int32_t EnetApp_filterPriorityPacketsCfg(Enet_Handle hEnet,
                                         uint32_t coreId)
{
    return EnetAppCombo_isIcssgHandle(hEnet) ? EnetApp_filterPriorityPacketsCfg_Icssg(hEnet, coreId) :
                                               EnetApp_filterPriorityPacketsCfg_Cpsw(hEnet, coreId);
}

int32_t EnetApp_getRxTimeStamp(Enet_Handle hEnet,
                               uint32_t coreId,
                               EnetTimeSync_GetEthTimestampInArgs *inArgs,
                               uint64_t *ts)
{
    return EnetAppCombo_isIcssgHandle(hEnet) ? EnetApp_getRxTimeStamp_Icssg(hEnet, coreId, inArgs, ts) :
                                               EnetApp_getRxTimeStamp_Cpsw(hEnet, coreId, inArgs, ts);
}

int32_t EnetApp_setTimeStampComplete(Enet_Handle hEnet,
                                     uint32_t coreId)
{
    return EnetAppCombo_isIcssgHandle(hEnet) ? EnetApp_setTimeStampComplete_Icssg(hEnet, coreId) :
                                               EnetApp_setTimeStampComplete_Cpsw(hEnet, coreId);
}

/* Both peripherals use the same UDMA instance */
Udma_DrvHandle EnetApp_getUdmaInstanceHandle(void)
{
    return EnetApp_getUdmaInstanceHandle_Icssg();
}

void EnetAppUtils_setCommonRxFlowPrms(EnetUdma_OpenRxFlowPrms *pRxFlowPrms)
{
    EnetAppUtils_setCommonRxFlowPrms_Icssg(pRxFlowPrms);
}

void EnetAppUtils_setCommonTxChPrms(EnetUdma_OpenTxChPrms *pTxChPrms)
{
    EnetAppUtils_setCommonTxChPrms_Icssg(pTxChPrms);
}
