%%{
    /* CPSW + ICSSG on one core: totals over both peripherals, used by the
     * packet / DMA memory generated once for both (see enet_combo) */
    let combo = system.getScript("/networking/common/enet_combo");
    /* Pool packet sizes: largest over the instances that use the packet pool */
    let instances = combo.getPktPoolInstances();
    if (instances.length === 0)
    {
        instances = combo.getModuleInstances(combo.icssModuleName);
    }
    let maxOf = (cfg) => Math.max(...instances.map((inst) => Number(inst[cfg])));
    let icssInst = combo.getModuleInstances(combo.icssModuleName)[0];
    let defaultNetif = combo.getDefaultNetif();
%%}

/* ========================================================================== */
/*          CPSW + ICSSG on one core: totals over both peripherals            */
/* ========================================================================== */

#define ENET_SYSCFG_MAX_ENET_INSTANCES      (ENET_SYSCFG_MAX_ENET_INSTANCES_ICSSG + ENET_SYSCFG_MAX_ENET_INSTANCES_CPSW)
#define ENET_SYSCFG_TOTAL_NUM_TX_PKT        (ENET_SYSCFG_TOTAL_NUM_TX_PKT_ICSSG + ENET_SYSCFG_TOTAL_NUM_TX_PKT_CPSW)
#define ENET_SYSCFG_TOTAL_NUM_RX_PKT        (ENET_SYSCFG_TOTAL_NUM_RX_PKT_ICSSG + ENET_SYSCFG_TOTAL_NUM_RX_PKT_CPSW)
#define ENET_SYSCFG_TX_CHANNELS_NUM         (ENET_SYSCFG_TX_CHANNELS_NUM_ICSSG + ENET_SYSCFG_TX_CHANNELS_NUM_CPSW)
#define ENET_SYSCFG_RX_FLOWS_NUM            (ENET_SYSCFG_RX_FLOWS_NUM_ICSSG + ENET_SYSCFG_RX_FLOWS_NUM_CPSW)
#define ENET_SYSCFG_RING_MON_NUM            (ENET_SYSCFG_RING_MON_NUM_ICSSG + ENET_SYSCFG_RING_MON_NUM_CPSW)
#define ENET_SYSCFG_MAX_MAC_PORTS           ((ENET_SYSCFG_MAX_MAC_PORTS_ICSSG > ENET_SYSCFG_MAX_MAC_PORTS_CPSW) ? \
                                             ENET_SYSCFG_MAX_MAC_PORTS_ICSSG : ENET_SYSCFG_MAX_MAC_PORTS_CPSW)
#define ENET_SYSCFG_PKT_POOL_ENABLE         (`Number(combo.isPktPoolEnabled(icssInst))`U)
#define ENET_SYSCFG_PKT_INFO_ONLY_ENABLE    (`Number(combo.isPktInfoOnlyEnabled(icssInst))`U)

/* lwIP netifs: ICSSG netifs first, then CPSW netifs */
#define ENET_SYSCFG_NETIF_COUNT             (ENET_SYSCFG_NETIF_COUNT_ICSSG + ENET_SYSCFG_NETIF_COUNT_CPSW)
% if (defaultNetif !== null) {
#define ENET_SYSCFG_DEFAULT_NETIF_IDX       (`defaultNetif.name.toUpperCase()`)
% }

#define ENET_MEM_LARGE_POOL_PKT_SIZE        ENET_UTILS_ALIGN(`maxOf("LargePoolPktSize")`U, ENET_UTILS_CACHELINE_SIZE)
#define ENET_MEM_MEDIUM_POOL_PKT_SIZE       ENET_UTILS_ALIGN(`maxOf("MediumPoolPktSize")`U, ENET_UTILS_CACHELINE_SIZE)
#define ENET_MEM_SMALL_POOL_PKT_SIZE        ENET_UTILS_ALIGN(`maxOf("SmallPoolPktSize")`U, ENET_UTILS_CACHELINE_SIZE)
