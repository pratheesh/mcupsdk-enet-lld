+    -DENABLE_ENET_LOG \
+    -DOS_FREERTOS \
+
+DEFINES_debug := \
+    -DENET_CFG_DEV_ERROR=1 \
+    -DLWIPIF_INSTRUMENTATION_ENABLED=1 \
+    -DENETDMA_INSTRUMENTATION_ENABLED=1 \
+
+CFLAGS_common := \
+    -mcpu=cortex-r5 \
+    -mfloat-abi=hard \
+    -mfpu=vfpv3-d16 \
